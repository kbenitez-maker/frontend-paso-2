# Backend the BFF proxy (`src/app/api/[...slug]`) and server-side http forward to.
# Point both URLs at the dxb-account-request API Gateway.
API_BASE_URL="https://<api-gateway-host>"
X_API_KEY="<x-api-key>"

# Same values, read by the server-side http client and the session server actions.
NEXT_PUBLIC_API_BASE_URL="https://<api-gateway-host>"
NEXT_PUBLIC_X_API_KEY="<x-api-key>"

# Home zone URL used by the close button and the `/account-request` redirect.
# Unset behind the portal (defaults to the same-origin path `/home`).
# Local without the portal: home runs on :3002.
# NEXT_PUBLIC_HOME_URL="http://localhost:3002/home"

# Local preview only. Leave unset in every deployed environment.
# FCJ_SECTIONS_API=
# FCJ_FORM_REQUEST_ID=
# FCJ_FORM_REQUESTS=
